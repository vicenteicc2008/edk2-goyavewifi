[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SprdMmcDxe
  FILE_GUID                      = 6E54BE28-06D7-49D0-9B36-CAD972587F7F
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SprdSdhciDxeInit

[Sources.common]
