[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  MSM8909Pkg/MSM8909Pkg.dec

[LibraryClasses]
  DebugLib
  ArmLib
  BaseLib
  UefiDriverEntryPoint
  TimerLib
  IoLib
  BaseMemoryLib

[Protocols]
  gEfiDiskIoProtocolGuid                        ## CONSUMES
  gEfiBlockIoProtocolGuid                       ## PRODUCES
  gEfiDevicePathProtocolGuid                    ## PRODUCES
  gEfiDriverDiagnostics2ProtocolGuid            ## SOMETIMES_PRODUCES
  gSprdGpioProtocolGuid
  gSprdMmcProtocolGuid

[BuildOptions.ARM]
  GCC:*_*_*_CC_FLAGS = -Wno-pointer-to-int-cast -Wno-overflow -Wno-unused-variable -Wno-unused-function

[Depex]
  TRUE